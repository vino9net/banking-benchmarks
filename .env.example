# Copy to .env (gitignored) and adjust if you're running infra/*.sh against a
# different AWS account/region than the one these scripts were built against.
#
# infra/config.sh sources .env before applying its own hardcoded defaults, so anything
# set here wins over those defaults but loses to a value already exported in your
# shell — e.g. `AWS_PROFILE=other ./infra/03_launch_core_sim_vm.sh` still overrides this
# file for that one invocation.

AWS_PROFILE=dev1
AWS_REGION=us-west-2
